{
  // Terminal > Ejecutar tarea... (Ctrl+Shift+P > "Tasks: Run Task")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "node",
        "pattern": { "regexp": "^(Error.*)$", "message": 1 },
        "background": { "activeOnStart": true, "beginsPattern": "Restarting|node --", "endsPattern": "Hiperfockie API en|No se pudo iniciar|Error de conexion" }
      },
      "presentation": { "group": "servidores", "panel": "dedicated" }
    },
    {
      "label": "Frontend: ng serve",
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": { "activeOnStart": true, "beginsPattern": "Changes detected|Building", "endsPattern": "bundle generation (complete|failed)|Local:" }
      },
      "presentation": { "group": "servidores", "panel": "dedicated" }
    },
    {
      "label": "Hiperfockie: todo",
      "dependsOn": ["Backend: dev", "Frontend: ng serve"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Backend: pruebas unitarias",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Backend: pruebas de integracion",
      "type": "shell",
      "command": "npm run test:api",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Instalar dependencias",
      "type": "shell",
      "command": "npm run instalar",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
